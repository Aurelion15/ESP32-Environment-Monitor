void handleAlarmReset() {
  alarmCount = 0;
  alarmState = false;
  alarmTotalTime = 0;
  digitalWrite(LED_BUILTIN, LOW);
  if (melodyPlaying) {
    melodyPlaying = false;
    noTone(BUZZER_PIN);
  }
  server.send(200, "text/plain", "Alarm Cleared!");
}

void handleReset() {
  resetStatistics();
  server.send(200, "text/plain", "Statistics Reset!");
}

// =====================================================
// EEPROM FUNCTIONS
// =====================================================

void loadSettings() {
  EEPROM.get(0, settings);
  
  if (settings.tempLimit > 0) {
    TEMP_LIMIT = settings.tempLimit;
    HUMIDITY_LIMIT = settings.humidityLimit;
    buzzerEnabled = settings.buzzerEnabled;
    melodyType = settings.melodyType;
    autoPage = settings.autoPage;
    Serial.println("[EEPROM] Settings loaded");
  } else {
    settings.tempLimit = 30.0;
    settings.humidityLimit = 80.0;
    settings.buzzerEnabled = true;
    settings.melodyType = 0;
    settings.pageInterval = 6000;
    settings.celsius = true;
    settings.autoPage = true;
    settings.darkMode = true;
    settings.brightness = 100;
    settings.showSeconds = true;
    saveSettings();
    Serial.println("[EEPROM] Default settings saved");
  }
}

void saveSettings() {
  settings.tempLimit = TEMP_LIMIT;
  settings.humidityLimit = HUMIDITY_LIMIT;
  settings.buzzerEnabled = buzzerEnabled;
  settings.melodyType = melodyType;
  settings.autoPage = autoPage;
  EEPROM.put(0, settings);
  EEPROM.commit();
  Serial.println("[EEPROM] Settings saved");
}

// =====================================================
// RESET STATISTICS
// =====================================================

void resetStatistics() {
  minTemp = temperature;
  maxTemp = temperature;
  minHumidity = humidity;
  maxHumidity = humidity;
  alarmCount = 0;
  alarmState = false;
  alarmTotalTime = 0;
  digitalWrite(LED_BUILTIN, LOW);
  if (melodyPlaying) {
    melodyPlaying = false;
    noTone(BUZZER_PIN);
  }
  Serial.println("[STATS] Statistics Reset");
}

