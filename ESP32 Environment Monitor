void printSerialData() {
  Serial.println("═══════════════════════════════════════");
  Serial.print("TEMP: ");
  Serial.print(temperature, 1);
  Serial.println(" C");
  
  Serial.print("HUMID: ");
  Serial.print(humidity, 0);
  Serial.println(" %");
  
  Serial.print("ALARM: ");
  Serial.println(alarmState ? "ACTIVE" : "NORMAL");
  
  if (alarmState) {
    Serial.print("  COUNT: ");
    Serial.println(alarmCount);
  }
  
  Serial.print("BUZZER: ");
  Serial.println(buzzerEnabled ? "ON" : "OFF");
  
  Serial.print("MELODY: ");
  Serial.println(melodyType + 1);
  
  Serial.print("PAGE: ");
  Serial.println(currentPage + 1);
  
  Serial.print("WEB: ");
  Serial.println(WiFi.softAPIP());
  Serial.println("═══════════════════════════════════════");
}
