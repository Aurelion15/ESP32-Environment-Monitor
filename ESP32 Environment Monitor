// MELODY FUNCTIONS
// =====================================================

void selectMelody(int type) {
  melodyType = type;
  
  switch (type) {
    case 0:
      currentMelody = melody0;
      currentDuration = duration0;
      currentMelodyLen = melody0Len;
      break;
    case 1:
      currentMelody = melody1;
      currentDuration = duration1;
      currentMelodyLen = melody1Len;
      break;
    case 2:
      currentMelody = melody2;
      currentDuration = duration2;
      currentMelodyLen = melody2Len;
      break;
    case 3:
      currentMelody = melody3;
      currentDuration = duration3;
      currentMelodyLen = melody3Len;
      break;
    case 4:
      currentMelody = melody4;
      currentDuration = duration4;
      currentMelodyLen = melody4Len;
      break;
    case 5:
      currentMelody = melody5;
      currentDuration = duration5;
      currentMelodyLen = melody5Len;
      break;
    case 6:
      currentMelody = melody6;
      currentDuration = duration6;
      currentMelodyLen = melody6Len;
      break;
    default:
      currentMelody = melody0;
      currentDuration = duration0;
      currentMelodyLen = melody0Len;
      break;
  }
}

void playMelodyNonBlocking() {
  unsigned long currentMillis = millis();
  
  if (melodyNoteIndex < currentMelodyLen) {
    if (currentMillis - melodyStartTime >= currentDuration[melodyNoteIndex]) {
      noTone(BUZZER_PIN);
      melodyNoteIndex++;
      
      if (melodyNoteIndex < currentMelodyLen) {
        tone(BUZZER_PIN, currentMelody[melodyNoteIndex], currentDuration[melodyNoteIndex]);
        melodyStartTime = currentMillis;
      } else {
        melodyPlaying = false;
        noTone(BUZZER_PIN);
      }
    }
  }
}

void playFullMelody(const int* melody, const int* durations, int length) {
  if (!buzzerEnabled) return;
  
  for (int i = 0; i < length; i++) {
    tone(BUZZER_PIN, melody[i], durations[i]);
    delay(durations[i] + 30);
    noTone(BUZZER_PIN);
  }
}

void startAlarmMelody() {
  if (!buzzerEnabled || melodyPlaying) return;
  
  melodyNoteIndex = 0;
  melodyStartTime = millis();
  melodyPlaying = true;
  tone(BUZZER_PIN, currentMelody[0], currentDuration[0]);
}

void playStartupMelody() {
  if (!buzzerEnabled) return;
  playFullMelody(melody0, duration0, 4);
}

void playReadyMelody() {
  if (!buzzerEnabled) return;
  tone(BUZZER_PIN, 1047, 100);
  delay(50);
  noTone(BUZZER_PIN);
}

void playClickTone() {
  if (!buzzerEnabled) return;
  tone(BUZZER_PIN, 1200, 25);
  delay(30);
  noTone(BUZZER_PIN);
}

void playBuzzerOnTone() {
  if (!buzzerEnabled) return;
  tone(BUZZER_PIN, 784, 100);
  delay(120);
  tone(BUZZER_PIN, 1047, 150);
  delay(50);
  noTone(BUZZER_PIN);
}

void playBuzzerOffTone() {
  if (!buzzerEnabled) return;
  tone(BUZZER_PIN, 1047, 100);
  delay(120);
  tone(BUZZER_PIN, 784, 150);
  delay(50);
  noTone(BUZZER_PIN);
}

// =====================================================
// SENSOR FUNCTIONS
// =====================================================

void readSensor() {
  float newHumidity = dht.readHumidity();
  float newTemperature = dht.readTemperature();
  
  if (isnan(newHumidity) || isnan(newTemperature)) {
    sensorErrors++;
    if (sensorErrors > 5) {
      sensorConnected = false;
      sensorErrorStart = millis();
    }
    return;
  }
  
  sensorErrors = 0;
  sensorConnected = true;
  
  if (temperature == 0 && humidity == 0) {
    temperature = newTemperature;
    humidity = newHumidity;
  } else {
    temperature = (newTemperature * 0.7) + (temperature * 0.3);
    humidity = (newHumidity * 0.7) + (humidity * 0.3);
  }
  
  if (temperature < minTemp) minTemp = temperature;
  if (temperature > maxTemp) maxTemp = temperature;
  if (humidity < minHumidity) minHumidity = humidity;
  if (humidity > maxHumidity) maxHumidity = humidity;
  
  static bool prevAlarm = false;
  bool currentAlarm = (temperature >= TEMP_LIMIT || humidity >= HUMIDITY_LIMIT);
  
  if (currentAlarm && !prevAlarm && buzzerEnabled) {
    startAlarmMelody();
    alarmCount++;
    alarmStartTime = millis();
  }
  
  prevAlarm = currentAlarm;
  
  static float lastTemp = -999;
  static float lastHum = -999;
  
  if (abs(temperature - lastTemp) > 0.1 || abs(humidity - lastHum) > 0.5) {
    lastTemp = temperature;
    lastHum = humidity;
    printSerialData();
  }
}

void updateHistory() {
  tempHistory[historyIndex] = temperature;
  humidityHistory[historyIndex] = humidity;
  historyIndex = (historyIndex + 1) % 180;
}

void updateStatistics() {
  float tempSum = 0;
  float humidSum = 0;
  int count = 0;
  
  for (int i = 0; i < 180; i++) {
    if (tempHistory[i] > 0) {
      tempSum += tempHistory[i];
      humidSum += humidityHistory[i];
      count++;
    }
  }
  
  if (count > 0) {
    tempAverage = tempSum / count;
    humidityAverage = humidSum / count;
  }
}

void updateTrend() {
  if (historyIndex >= 10) {
    float recentTemp = 0;
    float olderTemp = 0;
    int recentCount = 0;
    int olderCount = 0;
    
    for (int i = 0; i < 10; i++) {
      int idx = (historyIndex - 1 - i + 180) % 180;
      if (tempHistory[idx] > 0) {
        recentTemp += tempHistory[idx];
        recentCount++;
      }
    }
    
    for (int i = 10; i < 20; i++) {
      int idx = (historyIndex - 1 - i + 180) % 180;
      if (tempHistory[idx] > 0) {
        olderTemp += tempHistory[idx];
        olderCount++;
      }
    }
    
    if (recentCount > 0 && olderCount > 0) {
      tempTrend = (recentTemp / recentCount) - (olderTemp / olderCount);
    }
  }
}

// =====================================================
// BUTTON HANDLING
// =====================================================

void handleButtons() {
  bool raw1 = !digitalRead(BUTTON1_PIN);
  bool raw2 = !digitalRead(BUTTON2_PIN);
  
  if (raw1 != button1State) {
    lastDebounce1 = millis();
  }
  
  if ((millis() - lastDebounce1) > DEBOUNCE_DELAY) {
    if (raw1 && !button1Pressed) {
      button1Pressed = true;
      button1PressTime = millis();
      playClickTone();
      
      currentPage = (currentPage - 1 + TOTAL_PAGES) % TOTAL_PAGES;
      lastPageChange = millis();
      
      Serial.println("[BUTTON] Button 1: Page " + String(currentPage + 1));
      
    } else if (!raw1 && button1Pressed) {
      unsigned long pressDuration = millis() - button1PressTime;
      
      if (pressDuration >= LONG_PRESS_DELAY) {
        buzzerEnabled = !buzzerEnabled;
        settings.buzzerEnabled = buzzerEnabled;
        saveSettings();
        
        if (buzzerEnabled) {
          playBuzzerOnTone();
        } else {
          playBuzzerOffTone();
        }
        
        Serial.print("[BUTTON] Buzzer: ");
        Serial.println(buzzerEnabled ? "ON" : "OFF");
      }
      
      button1Pressed = false;
    }
  }
  
  if (raw2 != button2State) {
    lastDebounce2 = millis();
  }
  
  if ((millis() - lastDebounce2) > DEBOUNCE_DELAY) {
    if (raw2 && !button2Pressed) {
      button2Pressed = true;
      playClickTone();
      
      currentPage = (currentPage + 1) % TOTAL_PAGES;
      lastPageChange = millis();
      
      Serial.println("[BUTTON] Button 2: Page " + String(currentPage + 1));
      
    } else if (!raw2 && button2Pressed) {
      unsigned long pressDuration = millis() - button2PressTime;
      
      if (pressDuration >= LONG_PRESS_DELAY) {
        autoPage = !autoPage;
        settings.autoPage = autoPage;
        saveSettings();
        
        Serial.print("[BUTTON] Auto Page: ");
        Serial.println(autoPage ? "ON" : "OFF");
      }
      
      button2Pressed = false;
    }
  }
  
  button1State = raw1;
  button2State = raw2;
}

// =====================================================
// DISPLAY FUNCTIONS
// =====================================================

void updateDisplay() {
  if (!sensorConnected) {
    showErrorScreen();
    return;
  }
  
  switch (currentPage) {
    case 0: showMainPage(); break;
    case 1: showGraphPage(); break;
    case 2: showStatisticsPage(); break;
    case 3: showHistoryPage(); break;
    case 4: showTrendPage(); break;
    case 5: showSystemPage(); break;
    case 6: showClockPage(); break;
  }
}

