// =====================================================
// ALARM SYSTEM
// =====================================================

void checkAlarm() {
  bool tempAlarm = (temperature >= TEMP_LIMIT);
  bool humidAlarm = (humidity >= HUMIDITY_LIMIT);
  
  if (tempAlarm || humidAlarm) {
    alarmState = true;
    
    if (millis() - lastAlarmBlink >= 500) {
      lastAlarmBlink = millis();
      digitalWrite(LED_BUILTIN, !digitalRead(LED_BUILTIN));
    }
    
    if (buzzerEnabled && (millis() - lastMelodyPlay >= 10000) && !melodyPlaying) {
      lastMelodyPlay = millis();
      startAlarmMelody();
    }
    
    if (alarmStartTime > 0) {
      alarmTotalTime = millis() - alarmStartTime;
    }
    
  } else {
    if (alarmState) {
      alarmState = false;
      digitalWrite(LED_BUILTIN, LOW);
      
      if (melodyPlaying) {
        melodyPlaying = false;
        noTone(BUZZER_PIN);
      }
    }
  }
}

