// =====================================================
// PAGE 5: TREND ANALYSIS
// =====================================================

void showTrendPage() {
  display.clearDisplay();
  
  display.setTextSize(1);
  display.setCursor(2, 0);
  display.print("TREND ANALYSIS");
  display.drawLine(0, 9, 127, 9, SSD1306_WHITE);
  
  // Temperature Trend
  display.setCursor(2, 14);
  display.print("TEMP");
  display.setCursor(40, 14);
  display.print("TREND:");
  
  if (tempTrend > 0.5) {
    display.print("RISING");
  } else if (tempTrend < -0.5) {
    display.print("FALLING");
  } else {
    display.print("STABLE");
  }
  
  display.setCursor(95, 14);
  if (tempTrend > 0.5) {
    display.print("^");
  } else if (tempTrend < -0.5) {
    display.print("v");
  } else {
    display.print("-");
  }
  
  // Humidity Trend
  float humidTrend = 0;
  if (historyIndex >= 10) {
    float recent = 0, older = 0;
    int rc = 0, oc = 0;
    for (int i = 0; i < 10; i++) {
      int idx = (historyIndex - 1 - i + 180) % 180;
      if (humidityHistory[idx] > 0) { recent += humidityHistory[idx]; rc++; }
    }
    for (int i = 10; i < 20; i++) {
      int idx = (historyIndex - 1 - i + 180) % 180;
      if (humidityHistory[idx] > 0) { older += humidityHistory[idx]; oc++; }
    }
    if (rc > 0 && oc > 0) {
      humidTrend = (recent / rc) - (older / oc);
    }
  }
  
  display.setCursor(2, 26);
  display.print("HUMID");
  display.setCursor(40, 26);
  display.print("TREND:");
  
  if (humidTrend > 1) {
    display.print("RISING");
  } else if (humidTrend < -1) {
    display.print("FALLING");
  } else {
    display.print("STABLE");
  }
  
  display.setCursor(95, 26);
  if (humidTrend > 1) {
    display.print("^");
  } else if (humidTrend < -1) {
    display.print("v");
  } else {
    display.print("-");
  }
  
  // Alarm Stats
  display.setCursor(2, 40);
  display.print("ALARM");
  display.setCursor(40, 40);
  display.print("COUNT:");
  display.print(alarmCount);
  
  display.setCursor(2, 52);
  display.print("DURATION:");
  if (alarmState && alarmStartTime > 0) {
    unsigned long duration = (millis() - alarmStartTime) / 1000;
    display.print(duration);
    display.print("s");
  } else {
    display.print("0s");
  }
  
  display.setTextSize(1);
  display.setCursor(0, 61);
  display.print("P5");
  
  display.display();
}

