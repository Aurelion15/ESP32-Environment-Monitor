// =====================================================
// SETUP
// =====================================================

void setup() {
  
  Serial.begin(115200);
  Serial.println("╔════════════════════════════════════════╗");
  Serial.println("║     ESP32 ENVIRONMENT MONITOR v8.0     ║");
  Serial.println("║            ULTIMATE EDITION            ║");
  Serial.println("╚════════════════════════════════════════╝");
  
  EEPROM.begin(EEPROM_SIZE);
  loadSettings();
  
  dht.begin();
  delay(1000);
  
  pinMode(BUZZER_PIN, OUTPUT);
  noTone(BUZZER_PIN);
  
  pinMode(BUTTON1_PIN, INPUT_PULLUP);
  pinMode(BUTTON2_PIN, INPUT_PULLUP);
  
  Wire.begin(OLED_SDA, OLED_SCL);
  
  Serial.println("[OLED] Initializing display...");
  
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("[ERROR] OLED not found at address 0x3C!");
    Serial.println("[ERROR] Trying address 0x3D...");
    
    if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3D)) {
      Serial.println("[ERROR] OLED not found at 0x3D either!");
      Serial.println("[ERROR] Please check wiring!");
      
      while (true) {
        delay(1000);
        Serial.print(".");
      }
    }
  }
  
  Serial.println("[OLED] Display initialized successfully!");
  
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextWrap(false);
  display.display();
  
  pinMode(LED_BUILTIN, OUTPUT);
  digitalWrite(LED_BUILTIN, LOW);
  
  selectMelody(melodyType);
  playStartupMelody();
  showStartupScreen();
  
  WiFi.softAP(ssid, password);
  Serial.println("[WIFI] Access Point Started");
  Serial.print("[WIFI] IP Address: ");
  Serial.println(WiFi.softAPIP());
  
  if (MDNS.begin("esp32env")) {
    Serial.println("[MDNS] Started: esp32env.local");
  }
  
  setupWebServer();
  
  for (int i = 0; i < 180; i++) {
    tempHistory[i] = 0;
    humidityHistory[i] = 0;
  }
  
  readSensor();
  playReadyMelody();
  
  Serial.println("[SYSTEM] Ready!");
  Serial.println("╔════════════════════════════════════════╗");
  Serial.println("║  Connect to WiFi: ESP32_Env_Monitor  ║");
  Serial.println("║  Password: 12345678                  ║");
  Serial.println("║  Web: http://192.168.4.1             ║");
  Serial.println("╚════════════════════════════════════════╝");
  
  delay(1000);
}

// =====================================================
// MAIN LOOP
// =====================================================

void loop() {
  
  unsigned long currentMillis = millis();
  
  if (currentMillis - lastReading >= SENSOR_INTERVAL) {
    lastReading = currentMillis;
    readSensor();
    updateHistory();
  }
  
  handleButtons();
  
  if (autoPage && (currentMillis - lastPageChange >= AUTO_PAGE_INTERVAL)) {
    lastPageChange = currentMillis;
    if (!button1Pressed && !button2Pressed) {
      currentPage = (currentPage + 1) % TOTAL_PAGES;
    }
  }
  
  if (currentMillis - lastStatsUpdate >= STATS_INTERVAL) {
    lastStatsUpdate = currentMillis;
    updateStatistics();
  }
  
  if (currentMillis - lastTrendUpdate >= TREND_INTERVAL) {
    lastTrendUpdate = currentMillis;
    updateTrend();
  }
  
  if (currentMillis - lastWebUpdate >= WEB_INTERVAL) {
    lastWebUpdate = currentMillis;
    server.handleClient();
  }
  
  if (currentMillis - lastDisplayUpdate >= DISPLAY_INTERVAL) {
    lastDisplayUpdate = currentMillis;
    updateAnimation();
    updateDisplay();
  }
  
  if (currentMillis - lastClockUpdate >= CLOCK_INTERVAL) {
    lastClockUpdate = currentMillis;
  }
  
  checkAlarm();
  
  if (melodyPlaying) {
    playMelodyNonBlocking();
  }
  
  delay(5);
}

// =====================================================
// ANIMATION UPDATE
// =====================================================

void updateAnimation() {
  if (loadingBarPosition >= 124) {
    animationDirection = false;
  } else if (loadingBarPosition <= 0) {
    animationDirection = true;
  }
  
  if (animationDirection) {
    loadingBarPosition += 2;
  } else {
    loadingBarPosition -= 2;
  }
  
  waveOffset = (waveOffset + 1) % 128;
  animationFrame = (animationFrame + 1) % 100;
}

